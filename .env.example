PORT=8083
POSTGRES_USER=billing_app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=billing
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable
JWT_SECRET=change-me
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://ministack:4566
BILLING_QUEUE_URL=http://ministack:4566/000000000000/auto-repair-shop-local-billing-queue
BILLING_EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:auto-repair-shop-local-billing-events
PAYMENT_MODE=manual
# PAYMENT_MODE=mercadopago also needs the values below (never commit real ones). The access token is
# the long APP_USR-... value of the test seller account; the 44-character one is the public key.
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=
# MERCADOPAGO_NOTIFICATION_URL=https://<public host>/v1/webhooks/mercadopago
# MERCADOPAGO_CHECKOUT_TTL=12h
# GATEWAY_WORKER_INTERVAL=5s
LOG_LEVEL=INFO
